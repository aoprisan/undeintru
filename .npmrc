# No package gets to run code at install time. Every install in this
# repository -- npm ci, npm install, CI, scripts/populate.sh -- skips
# preinstall/install/postinstall hooks. The only package that ships one is
# esbuild, whose hook merely checks for the prebuilt platform binary that the
# lockfile already pins as an optional dependency; the toolchain has been
# verified to install, check and build without it. `npm run <script>` and
# `npm test` are unaffected: this only blocks hooks that would run unasked.
ignore-scripts=true
